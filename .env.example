# Copy to .env for local development. Do not commit .env.

# development, test, or production
ENVIRONMENT=development

# DEBUG, INFO, WARNING, ERROR, or CRITICAL
LOG_LEVEL=INFO

# SQLite file created in the backend working directory
DATABASE_URL=sqlite:///./cryptonex.db

# Comma-separated browser origins. Production rejects "*" and an empty list.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
