# Copy to .env for local development. Do not commit .env.

# development, test, or production
ENVIRONMENT=development

# DEBUG, INFO, WARNING, ERROR, or CRITICAL
LOG_LEVEL=INFO

# SQLite file created in the backend working directory
DATABASE_URL=sqlite:///./cryptonex.db

# Comma-separated browser origins. Production rejects "*" and an empty list.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server-controlled directory for ingested repositories. Not exposed by the API.
WORKSPACE_ROOT=./workspaces

# Fixed git executable name or path. Never taken from repository content.
GIT_EXECUTABLE=git

# Ingestion limits
MAX_REPOSITORY_SIZE_MB=100
MAX_FILE_COUNT=10000
MAX_FILE_SIZE_MB=10
CLONE_TIMEOUT_SECONDS=120
MAX_ZIP_SIZE_MB=50
MAX_ZIP_EXTRACTED_SIZE_MB=200

# Directories skipped by the deterministic crypto scanner
SCAN_EXCLUDED_DIRECTORIES=node_modules,vendor,dist,build,.git,__pycache__,.venv,venv,target

# Maximum characters stored in a finding evidence snippet
EVIDENCE_MAX_CHARS=240
